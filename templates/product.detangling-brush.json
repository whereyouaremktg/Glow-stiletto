          "type": "accordion",
          "settings": {
            "expand_by_default": false,
            "column_placement": "right",
            "heading": "How to use",
            "heading_tag": "h3",
            "icon": "none",
            "content": "<p><strong>1.</strong> Start at the ends of damp or dry hair and gently work upward toward the roots.</p><p><strong>2.</strong> In the shower, brush through conditioner to distribute it evenly and detangle with ease.</p><p><strong>3.</strong> Finish with long strokes from scalp to ends to stimulate circulation and bring out shine.</p><p><strong>4.</strong> Rinse the brush under water — the drainage hole lets it dry fast and stay fresh.</p>"
          }
        },
