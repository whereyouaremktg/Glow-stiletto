      "type": "collapsible-row-list",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "leaf",
            "title": "What is The Glow Method?",
            "text": "<p>Marissa's signature approach to blonding, extensions, and shadowing — the techniques she teaches stylists across the country. It's also the philosophy that shapes every product we make: visible, beautiful results without the damage.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "scissors",
            "title": "Are Glow brushes really salon-grade?",
            "text": "<p>Yes. They're the same brushes Marissa and her stylists use in the chair every day. Metal bristles, drainage holes on the wet brush, extension-safe, built to last. If a stylist wouldn't use it, we don't sell it.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "package-open",
            "title": "Do you offer salon wholesale?",
            "text": "<p>We do. Glow partners with salons across the U.S. through our wholesale program — pro pricing, marketing support, and access to The Glow Method curriculum. Reach out via the salon login link in the header.</p>"
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
