{%- liquid
  assign cols = section.settings.columns | default: '4'
-%}

<div
  class="glow-section glow-ugc section {% if section.settings.full_bleed %}section--full-width{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="glow-ugc"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
    --glow-ugc-cols: {{ cols }};
  "
>
  <div class="glow-container glow-ugc__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank or section.settings.rating_text != blank -%}
      <div class="glow-ugc__intro">
        {%- if section.settings.eyebrow != blank -%}
          <span class="glow-eyebrow glow-ugc__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="glow-ugc__heading ff-glow-display-2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="glow-ugc__subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
        {%- if section.settings.rating_text != blank -%}
          <div class="glow-ugc__rating">
            <span class="glow-ugc__stars" aria-hidden="true">★★★★★</span>
            <span class="glow-ugc__rating-text">{{ section.settings.rating_text }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="glow-ugc__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'post' -%}
            <article class="glow-ugc__card glow-ugc__card--post" {{ block.shopify_attributes }}>
              <div class="glow-ugc__media">
                {%- render 'image',
                  image: block.settings.image,
                  wrapper_class: 'glow-ugc__media-image',
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 80vw',
                  focal_point: block.settings.focal_point,
                  include_placeholder: true,
                  placeholder_name: 'lifestyle-1',
                  src_set_type: 'grid'
                -%}
                {%- if block.settings.handle != blank -%}
                  <span class="glow-ugc__handle">{{ block.settings.handle }}</span>
                {%- endif -%}
                {%- if block.settings.badge != blank -%}
                  <span class="glow-ugc__badge">{{ block.settings.badge }}</span>
                {%- endif -%}
              </div>
              <div class="glow-ugc__content">
                {%- if block.settings.rating > 0 -%}
                  <span class="glow-ugc__card-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                    {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
                  </span>
                {%- endif -%}
                {%- if block.settings.quote != blank -%}
                  <p class="glow-ugc__quote">{{ block.settings.quote }}</p>
                {%- endif -%}
                {%- if block.settings.author != blank -%}
                  <span class="glow-ugc__author">{{ block.settings.author }}</span>
                {%- endif -%}
              </div>
            </article>

          {%- when 'quote' -%}
            <article class="glow-ugc__card glow-ugc__card--quote" {{ block.shopify_attributes }}>
              <span class="glow-ugc__quote-mark" aria-hidden="true">&ldquo;</span>
              {%- if block.settings.quote != blank -%}
                <div class="glow-ugc__big-quote ff-glow-display-3 rte">{{ block.settings.quote }}</div>
              {%- endif -%}
              {%- if block.settings.author != blank -%}
                <span class="glow-ugc__author glow-ugc__author--quote">{{ block.settings.author }}</span>
              {%- endif -%}
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Glow UGC + quotes",
  "tag": "section",
  "class": "shopify-section--full-width",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "#GLOWBRUSH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by real hair, everywhere"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Tag @glowbeautyhair to be featured.</p>"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Aggregate rating text",
      "default": "4.9/5 from 2,400+ happy customers"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "default": "4",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF6F1"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Full-bleed",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "UGC post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "select",
          "id": "focal_point",
          "label": "Focal point",
          "default": "image_presentation",
          "options": [
            { "value": "image_presentation", "label": "From image" },
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ]
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Quote",
          "default": "This brush changed my hair routine."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Verified Buyer"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle / overlay label (optional)"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (optional)"
        }
      ]
    },
    {
      "type": "quote",
      "name": "Pull quote",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>The only brush I'll ever need. Detangles in seconds, no tugging.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Attribution",
          "default": "— Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glow UGC + quotes",
      "blocks": [
        { "type": "post", "settings": { "quote": "Twenty minutes of detangling down to two. No tears.", "author": "Maya R.", "handle": "@maya.r", "badge": "VERIFIED" } },
        { "type": "quote", "settings": { "quote": "<p>The drainage hole is genuinely genius.</p>", "author": "— ELLE" } },
        { "type": "post", "settings": { "quote": "My hair has never been shinier. Use it every shower.", "author": "Priya S.", "handle": "@priya.styles", "badge": "VERIFIED" } },
        { "type": "post", "settings": { "quote": "Bought 4 — everyone I gift it to gets obsessed.", "author": "Jordan L.", "handle": "@jordanl", "badge": "VERIFIED" } }
      ]
    }
  ]
}
{% endschema %}
