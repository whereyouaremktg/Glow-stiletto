{%- liquid
  assign prioritize_loading = false
  if section.index == 1
    assign prioritize_loading = true
  endif
-%}

<div
  class="
    glow-section
    section
    {% if section.settings.full_bleed %}section--full-width{% endif %}
  "
  data-section-id="{{ section.id }}"
  data-section-type="glow-shoppable-look"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  "
>
  {%- if section.settings.heading != blank -%}
    <div class="glow-results-compare__intro">
      <h2 class="glow-story-stack__heading ff-glow-display-2">{{ section.settings.heading }}</h2>
      {%- unless section.settings.subheading == blank -%}
        <div class="rte" style="line-height: 1.6; color: var(--glow-color-muted); margin-top: var(--glow-space-s);">{{ section.settings.subheading }}</div>
      {%- endunless -%}
    </div>
  {%- endif -%}

  <div class="glow-shoppable-look" data-glow-shoppable>
    <div class="glow-shoppable-look__image-wrapper">
      {%- render 'image',
        image: section.settings.image,
        wrapper_class: 'glow-shoppable-look__image',
        sizes: '100vw',
        focal_point: section.settings.focal_point,
        include_placeholder: true,
        placeholder_name: 'lifestyle-1',
        prioritize_loading: prioritize_loading
      -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'hotspot' -%}
          {%- assign product = block.settings.product -%}
          <button
            type="button"
            class="glow-shoppable-look__hotspot"
            data-glow-hotspot
            aria-expanded="false"
            aria-controls="glow-hotspot-card-{{ block.id }}"
            aria-label="{% if product %}{{ product.title | escape }}{% else %}Shop this look{% endif %}"
            style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;"
            {{ block.shopify_attributes }}
          >+</button>
          <div
            id="glow-hotspot-card-{{ block.id }}"
            class="glow-shoppable-look__card"
            data-glow-hotspot-card
            aria-hidden="true"
            style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;"
          >
            {%- if product != blank -%}
              <a href="{{ product.url }}" class="glow-shoppable-look__card-link">
                <div class="glow-shoppable-look__card-image">
                  {%- render 'image',
                    image: product.featured_image,
                    sizes_px: 240,
                    placeholder_name: 'product-1',
                    include_placeholder: true
                  -%}
                </div>
                <div class="glow-shoppable-look__card-title">{{ product.title }}</div>
                <div class="glow-shoppable-look__card-price">{{ product.price | money }}</div>
              </a>
            {%- else -%}
              <div class="glow-shoppable-look__card-title">Pick a product in the editor</div>
              <div class="glow-shoppable-look__card-price">—</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Glow shoppable look",
  "tag": "section",
  "class": "shopify-section--full-width",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Look image"
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Focal point",
      "default": "image_presentation",
      "options": [
        { "value": "image_presentation", "label": "From image" },
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF6F1"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Full-bleed",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Linked product"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glow shoppable look",
      "blocks": [
        { "type": "hotspot", "settings": { "x": 35, "y": 45 } },
        { "type": "hotspot", "settings": { "x": 65, "y": 60 } },
        { "type": "hotspot", "settings": { "x": 50, "y": 80 } }
      ]
    }
  ]
}
{% endschema %}
