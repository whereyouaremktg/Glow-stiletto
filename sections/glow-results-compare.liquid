{%- liquid
  assign before_block = section.blocks | where: 'type', 'image' | first
  assign blocks_size = section.blocks.size
-%}

<div
  class="
    glow-section
    section
    {% if section.settings.full_bleed %}section--full-width{% endif %}
  "
  data-section-id="{{ section.id }}"
  data-section-type="glow-results-compare"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  "
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="glow-results-compare__intro">
      {%- unless section.settings.heading == blank -%}
        <h2 class="glow-results-compare__heading ff-glow-display-2">{{ section.settings.heading }}</h2>
      {%- endunless -%}
      {%- unless section.settings.subheading == blank -%}
        <div class="rte glow-intro-subheading">{{ section.settings.subheading }}</div>
      {%- endunless -%}
    </div>
  {%- endif -%}

  {%- if blocks_size >= 2 -%}
    {%- assign before = section.blocks[0] -%}
    {%- assign after  = section.blocks[1] -%}
    <div
      class="glow-results-compare__slider"
      data-glow-compare
      style="--glow-slider-pos: 50%;"
    >
      <div class="glow-results-compare__before" {{ before.shopify_attributes }}>
        {%- render 'image',
          image: before.settings.image,
          wrapper_class: 'glow-results-compare__before-image',
          sizes: '100vw',
          focal_point: before.settings.focal_point,
          include_placeholder: true,
          placeholder_name: 'lifestyle-2',
          src_set_type: 'full-width'
        -%}
        {%- if section.settings.show_labels and section.settings.before_label != blank -%}
          <span class="glow-results-compare__label glow-results-compare__label--before">{{ section.settings.before_label }}</span>
        {%- endif -%}
      </div>
      <div class="glow-results-compare__after" {{ after.shopify_attributes }}>
        {%- render 'image',
          image: after.settings.image,
          wrapper_class: 'glow-results-compare__after-image',
          sizes: '100vw',
          focal_point: after.settings.focal_point,
          include_placeholder: true,
          placeholder_name: 'lifestyle-2',
          src_set_type: 'full-width'
        -%}
        {%- if section.settings.show_labels and section.settings.after_label != blank -%}
          <span class="glow-results-compare__label glow-results-compare__label--after">{{ section.settings.after_label }}</span>
        {%- endif -%}
      </div>
      <div class="glow-results-compare__handle" aria-hidden="true"></div>
      <input
        type="range"
        class="glow-results-compare__range"
        data-glow-compare-range
        min="0"
        max="100"
        value="50"
        step="any"
        aria-label="Reveal after image"
      >
    </div>
  {%- endif -%}

  {%- unless section.settings.caption == blank -%}
    <div class="glow-results-compare__caption">{{ section.settings.caption }}</div>
  {%- endunless -%}
</div>

{% schema %}
{
  "name": "Glow results compare",
  "tag": "section",
  "class": "shopify-section--full-width",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See the difference"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Real results from real customers. Drag the slider to compare.</p>"
    },
    {
      "type": "header",
      "content": "Slider labels"
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show before/after labels",
      "default": true
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "BEFORE"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "AFTER"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption (below slider)",
      "default": "After 4 weeks of daily use"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF6F1"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Full-bleed",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Before/After image",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "focal_point",
          "label": "Focal point",
          "default": "image_presentation",
          "options": [
            { "value": "image_presentation", "label": "From image" },
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glow results compare",
      "blocks": [
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
