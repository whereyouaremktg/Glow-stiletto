{%- liquid
  assign badges = section.blocks | where: 'type', 'badge'
-%}

<div
  class="glow-section glow-badge-row section {% if section.settings.full_bleed %}section--full-width{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="glow-badge-row"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  "
>
  <div class="glow-container glow-badge-row__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="glow-badge-row__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="glow-badge-row__heading ff-glow-display-3">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="glow-badge-row__subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="glow-badge-row__items">
      {%- for block in badges -%}
        <div class="glow-badge-row__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <span class="glow-badge-row__coin">
              {%- render 'image',
                image: block.settings.image,
                sizes_px: 200,
                focal_point: 'image_presentation',
                include_placeholder: false
              -%}
            </span>
          {%- else -%}
            <span class="glow-badge-row__coin glow-badge-row__coin--placeholder" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="10" r="1.6" fill="currentColor"/><path d="M21 15.5 16 10.5 5 19.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <span class="glow-badge-row__label">{{ block.settings.label }}</span>
          {%- endif -%}
          {%- if block.settings.sublabel != blank -%}
            <span class="glow-badge-row__sublabel">{{ block.settings.sublabel }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Glow badge row",
  "tag": "section",
  "class": "shopify-section--full-width",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Circular trust badges. Leave an image empty to show a placeholder coin you can fill in later."
    },
    {
      "type": "header",
      "content": "Intro (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF6F1"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Full-bleed",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Badge image (leave empty for placeholder)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "BADGE"
        },
        {
          "type": "text",
          "id": "sublabel",
          "label": "Sublabel (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glow badge row",
      "blocks": [
        { "type": "badge", "settings": { "label": "ALL HAIR TYPES" } },
        { "type": "badge", "settings": { "label": "DRAINAGE HOLE" } },
        { "type": "badge", "settings": { "label": "METAL BRISTLES" } },
        { "type": "badge", "settings": { "label": "CRUELTY-FREE" } }
      ]
    }
  ]
}
{% endschema %}
