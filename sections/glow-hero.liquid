{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign prioritize_loading = false
  if section.index == 1
    assign prioritize_loading = true
  endif

  assign has_mobile_image = false
  if section.settings.image_mobile != blank
    assign has_mobile_image = true
  endif
-%}

<div
  class="
    glow-hero-wrap
    section
    {% if section.settings.full_bleed %}section--full-width{% endif %}
  "
  data-section-id="{{ section.id }}"
  data-section-type="glow-hero"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.outer_bg }};
  "
>
  <div
    class="
      glow-hero
      glow-hero--height-{{ section.settings.height }}
      glow-hero--align-{{ section.settings.alignment }}
    "
    style="
      --glow-hero-text: {{ section.settings.text_color }};
      --glow-overlay-color: {{ section.settings.overlay_color }};
      --glow-overlay-opacity: {{ overlay_opacity }};
    "
  >
    <div class="glow-hero__media-wrap">
      <div class="glow-hero__media-desktop {% if has_mobile_image %}has-mobile{% endif %}">
        {%- render 'image',
          image: section.settings.image,
          wrapper_class: 'glow-hero__media-image',
          sizes: '100vw',
          focal_point: section.settings.focal_point,
          include_placeholder: true,
          placeholder_name: 'lifestyle-1',
          src_set_type: 'full-width',
          prioritize_loading: prioritize_loading
        -%}
      </div>
      {%- if has_mobile_image -%}
        <div class="glow-hero__media-mobile">
          {%- render 'image',
            image: section.settings.image_mobile,
            wrapper_class: 'glow-hero__media-image',
            sizes: '100vw',
            focal_point: section.settings.mobile_focal_point,
            src_set_type: 'full-width',
            prioritize_loading: prioritize_loading
          -%}
        </div>
      {%- endif -%}
      <div class="glow-hero__overlay"></div>
    </div>

    <div class="glow-hero__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'chip' -%}
            {%- unless block.settings.text == blank -%}
              <span class="glow-chip" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            {%- endunless -%}
          {%- when 'eyebrow' -%}
            {%- unless block.settings.text == blank -%}
              <span class="glow-eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            {%- endunless -%}
          {%- when 'heading' -%}
            {%- unless block.settings.text == blank -%}
              <{{ block.settings.tag }} class="glow-hero__heading ff-glow-display-1" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </{{ block.settings.tag }}>
            {%- endunless -%}
          {%- when 'body' -%}
            {%- unless block.settings.text == blank -%}
              <div class="glow-hero__body rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endunless -%}
          {%- when 'button' -%}
            {%- render 'button-block',
              wrapper_class: 'glow-hero__button',
              link: block.settings.link,
              label: block.settings.text,
              button_style: block.settings.button_style,
              shopify_attributes: block.shopify_attributes,
              is_overlay: true,
              button_alignment: section.settings.alignment
            -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Glow hero",
  "tag": "section",
  "class": "shopify-section--full-width",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)"
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Desktop focal point",
      "default": "image_presentation",
      "options": [
        { "value": "image_presentation", "label": "From image" },
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_focal_point",
      "label": "Mobile focal point",
      "default": "image_presentation",
      "options": [
        { "value": "image_presentation", "label": "From image" },
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "large",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large (80vh)" },
        { "value": "medium", "label": "Medium (60vh)" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Full-bleed (edge to edge)",
      "default": true
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "outer_bg",
      "label": "Outer background",
      "default": "#FAF6F1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip / pill badge",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Chip text",
          "default": "LIMITED EDITION"
        }
      ]
    },
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Eyebrow text",
          "default": "NEW"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Welcome to Glow"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "Heading tag",
          "default": "h1",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" }
          ]
        }
      ]
    },
    {
      "type": "body",
      "name": "Body",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Body",
          "default": "<p>Elevating your daily routine with functional, reliable, and timeless tools.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Label",
          "default": "Explore collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Style",
          "default": "btn--primary",
          "options": [
            { "value": "btn--primary", "label": "Solid (filled)" },
            { "value": "btn--secondary", "label": "Outline" },
            { "value": "btn--callout", "label": "Text" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glow hero",
      "blocks": [
        { "type": "heading" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
